# Copie estes nomes para as "variáveis de ambiente" da hospedagem. NUNCA coloque os valores reais no GitHub.
# Banco de dados (Supabase: botão Connect > Session pooler > aba JDBC; separe usuário e senha como abaixo)
DB_URL=jdbc:postgresql://COLE-AQUI-O-HOST-DO-SESSION-POOLER:5432/postgres?sslmode=require
DB_USER=postgres.REFERENCIA-DO-SEU-PROJETO
DB_PASSWORD=SENHA-DO-BANCO-DEFINIDA-NO-SUPABASE
# Sua conta de administrador (criada na primeira vez que o sistema liga; senha com 10 caracteres ou mais)
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=UMA-SENHA-FORTE-AQUI
# Obrigatório quando o sistema estiver em HTTPS (hospedagem)
COOKIE_SECURE=true
