# Variáveis que vão na Vercel (Settings > Environment Variables). NUNCA coloque os valores reais no GitHub.
# Supabase > Project Settings > API (ou botão "Connect")
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta: "service_role" (formato antigo) ou "secret" (sb_secret_...). Só na Vercel!
SUPABASE_SERVICE_ROLE_KEY=COLE-AQUI-A-CHAVE-SECRETA
